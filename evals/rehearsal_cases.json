  {
    "id": "schedule-feasible",
    "kind": "schedule",
    "title": "轨道之外",
    "version_label": "eval-v1",
    "script_path": "docs/examples/qidian-demo-script.md",
    "analysis_mode": "rules",
    "review_status": "confirmed",
    "default_minutes": 45,
    "slots": [
      {"actor": "导演", "date": "2026-08-25", "start": "19:00", "end": "21:00"},
      {"actor": "小林", "date": "2026-08-25", "start": "19:00", "end": "21:00"},
      {"actor": "许教授", "date": "2026-08-25", "start": "19:00", "end": "21:00"},
      {"actor": "小周", "date": "2026-08-25", "start": "19:00", "end": "21:00"}
    ],
    "expected": {
      "task_count": 2,
      "scheduled_count": 2,
      "unassigned_count": 0,
      "parallel_groups": [1, 2],
      "tool_names": [
        "inspect_script",
        "extract_scene_requirements",
        "extract_scene_requirements",
        "group_parallel_tasks",
        "validate_schedule_draft",
        "find_common_actor_slot",
        "find_common_actor_slot",
        "validate_schedule"
      ],
      "tool_phases": [
        "inspect",
        "extract",
        "extract",
        "group",
        "validate",
        "assign",
        "assign",
        "validate"
      ],
      "tool_result_keys_by_name": {
        "inspect_script": ["review_gate"],
        "extract_scene_requirements": ["required_characters", "props", "estimated_minutes"],
        "group_parallel_tasks": ["parallel_group_count", "groups"],
        "validate_schedule_draft": ["draft_valid", "unassigned_count"],
        "find_common_actor_slot": ["status", "date", "start", "end"],
        "validate_schedule": ["scheduled_count", "unassigned_count", "overlap_count"]
      },
      "first_task_end_equals_second_start": true,
      "second_task_reason_contains": "共享资源",
      "run_linkage": {
        "draft_run_id": "11111111111111111111111111111111",
        "plan_run_id": "22222222222222222222222222222222"
      },
      "batch_override": {
        "items": [
          {"date": "2026-08-26", "start": "19:00", "end": "19:45"},
          {"date": "2026-08-26", "start": "19:45", "end": "20:30"}
        ],
        "count": 2,
        "repeat_error_contains": "批量重复提交被拒绝"
      },
      "batch_override_errors": [
        {
          "task_indices": [0, 1],
          "items": [
            {"date": "2026-08-27", "start": "19:00", "end": "19:45"},
            {"date": "2026-08-27", "start": "19:00", "end": "19:45"}
          ],
          "message_contains": "批量确认存在资源冲突"
        },
        {
          "task_indices": [0, 0],
          "items": [
            {"date": "2026-08-27", "start": "20:00", "end": "20:45"},
            {"date": "2026-08-27", "start": "20:00", "end": "20:45"}
          ],
          "message_contains": "不能重复包含同一排练任务"
        }
      ]
    }
  },
